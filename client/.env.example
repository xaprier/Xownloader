# Base URL of the Xownloader server (no trailing slash, no port when behind
# a reverse proxy on 443), e.g. https://xownloader.example.com
XOWNLOADER_SERVER_URL=http://127.0.0.1:8000

# Client-scope API token. Must match the server's XOWNLOADER_CLIENT_API_TOKEN.
# Leave empty when the server runs without auth (development) or when a reverse
# proxy injects the Authorization header for you.
XOWNLOADER_CLIENT_API_TOKEN=
