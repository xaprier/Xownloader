XOWNLOADER_ENVIRONMENT=development
XOWNLOADER_CLIENT_API_TOKEN=
XOWNLOADER_ADMIN_API_TOKEN=
XOWNLOADER_HOST=127.0.0.1
XOWNLOADER_PORT=8000
# Host port the container publishes on (docker compose only). Change when 8000
# is taken; the reverse proxy must point at the same port.
XOWNLOADER_HOST_PORT=8000
XOWNLOADER_DOWNLOAD_DIRECTORY=./data/downloads
XOWNLOADER_DATABASE_PATH=./data/xownloader.db
XOWNLOADER_RETENTION_HOURS=24
XOWNLOADER_MAX_CONCURRENT_DOWNLOADS=2
XOWNLOADER_MAX_QUEUE_SIZE=50
XOWNLOADER_RATE_LIMIT_REQUESTS_PER_MINUTE=10
XOWNLOADER_PREVIEW_RATE_LIMIT_REQUESTS_PER_MINUTE=30
XOWNLOADER_MAX_FILE_SIZE_MB=2048
XOWNLOADER_MIN_FREE_DISK_MB=1024
XOWNLOADER_CLEANUP_INTERVAL_MINUTES=15
XOWNLOADER_ALLOWED_OUTPUT_FORMATS=mp4,mp3
XOWNLOADER_ALLOWED_VIDEO_QUALITIES=480p,720p,1080p
XOWNLOADER_ALLOWED_AUDIO_BITRATES=128K,192K,320K
XOWNLOADER_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Instagram provider (optional). Without a cookie the server rejects Instagram
# URLs. Obtain it while logged in: browser F12 > Network > any instagram.com
# request > Request Headers > Cookie. Paste the whole value. It expires after
# days to weeks; refresh it when Instagram downloads start returning
# "session is invalid or expired". Treat it as a secret.
XOWNLOADER_INSTAGRAM_COOKIE=
# Seconds to wait between carousel file downloads (rate-limit easing).
XOWNLOADER_INSTAGRAM_DOWNLOAD_DELAY_SECONDS=2.0
